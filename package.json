{
  "name": "@vinhnnn/dev-workflow",
  "version": "3.0.1",
  "description": "Conventions seed + managed doc/task templates + the metadata gate (dev-workflow check). Claude reads the seed, scaffolds the project, and CI keeps the metadata honest.",
  "keywords": [
    "cli",
    "release",
    "scaffolder",
    "sprint",
    "workflow"
  ],
  "homepage": "https://github.com/vinhnhq/dev-workflow#readme",
  "bugs": {
    "url": "https://github.com/vinhnhq/dev-workflow/issues"
  },
  "license": "MIT",
  "author": "vinhnnn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhnhq/dev-workflow.git"
  },
  "bin": {
    "dev-workflow": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "lib",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome ci . && tsc --noEmit",
    "pretest": "npm run lint",
    "test": "node --test tests/*.test.mjs",
    "format": "biome check --write .",
    "format:check": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
