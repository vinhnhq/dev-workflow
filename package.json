{
  "name": "@vinhnnn/dev-workflow",
  "version": "2.4.0",
  "description": "Drops dev-workflow.md (conventions) + a dev-workflow-pipeline/ staging folder into your project. Claude Code reads them, asks the project-specific questions, and scaffolds from there.",
  "type": "module",
  "bin": {
    "dev-workflow": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "pretest": "npm run lint",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "workflow",
    "scaffolder",
    "sprint",
    "release",
    "cli"
  ],
  "author": "vinhnnn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhnhq/dev-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/vinhnhq/dev-workflow/issues"
  },
  "homepage": "https://github.com/vinhnhq/dev-workflow#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
